APP_ENV=development
AGENT_PORT=8002

# Keep mock mode until AWS Bedrock is available.
AI_PROVIDER=mock

# AWS Bedrock configuration (fill these when you create an AWS account).
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# AWS credentials:
# Preferred: configure the AWS credential chain with `aws configure`.
# Do NOT commit or share real credentials.
# If you intentionally use environment credentials locally, boto3 can read:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

ML_PROVIDER=http
ML_SERVICE_URL=http://localhost:8001
BACKEND_URL=http://localhost:3000
BACKEND_ROLE=GOVT
BACKEND_ACTOR_ID=ai-agent
BACKEND_TIMEOUT_SECONDS=5
AGENT_SERVICE_URL=http://localhost:8002
ML_TIMEOUT_SECONDS=5
BEDROCK_TIMEOUT_SECONDS=30
SERVICE_VERSION=0.1.0
