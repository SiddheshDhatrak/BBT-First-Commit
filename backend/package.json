{
  "name": "rahatsetu-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Modular hackathon backend for transparent disaster-relief fund and impact verification.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "lint": "eslint src tests scripts",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts",
    "migrate:create": "node-pg-migrate create",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1135.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1136.0",
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/client-sesv2": "^3.1136.0",
    "@aws-sdk/client-textract": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "aws-jwt-verify": "^5.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.9.7"
  }
}
