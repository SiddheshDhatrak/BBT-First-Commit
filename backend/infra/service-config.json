      "VpcConnectorArn": "arn:aws:apprunner:ap-south-1:013659367345:vpcconnector/rahatsetu-vpc-connector/1/15f5f0d4fcaf4fedaa491db53f0d62e6"
    },
    "IngressConfiguration": {
      "IsPubliclyAccessible": true
    },
    "IpAddressType": "IPV4"
  }
