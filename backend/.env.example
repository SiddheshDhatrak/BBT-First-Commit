# RahatSetu Backend Configuration
# Copy to .env and fill in values. Never commit real secrets.

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Repository driver: 'memory' (dev/test only) or 'postgres'
# Managed Postgres (chosen for E2E): set REPOSITORY_DRIVER=postgres and
# DATABASE_URL to the managed connection string, then run:
#   npm run migrate:up
REPOSITORY_DRIVER=postgres

# Database — managed Postgres for E2E (require SSL):
#   DATABASE_URL=postgres://<user>:<password>@<host>:5432/<db>?sslmode=require
DATABASE_URL=
DATABASE_SSL=true

# AWS Configuration (required — backend verifies Cognito access tokens)
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
EVIDENCE_BUCKET=

# Feature Flags — E2E/live requires both false (demo headers off, real adapters on).
# Keep true only for throwaway local demos without Cognito/AWS.
FEATURE_DEMO_ROLE_HEADERS=false
FEATURE_MOCK_ADAPTERS=false

# API Hardening — restrict to the frontend origin in E2E/prod:
#   CORS_ORIGIN=http://localhost:5173  (local) or https://<amplify-domain> (prod)
CORS_ORIGIN=http://localhost:5173
JSON_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
