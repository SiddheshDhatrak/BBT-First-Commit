# RahatSetu Backend Configuration
# Copy to .env and fill in values. Never commit real secrets.

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Repository driver: 'memory' (dev/test only) or 'postgres'
REPOSITORY_DRIVER=memory

# Database (PostgreSQL for E2E/production)
DATABASE_URL=postgres://rahatsetu:rahatsetu@localhost:5433/rahatsetu
DATABASE_SSL=false

# AWS Cognito — the backend owns ALL Cognito calls (AdminCreateUser,
# InitiateAuth USER_PASSWORD_AUTH, groups). Required:
#   1) User Pool with groups: DONOR, NGO, VENDOR, FIELD, GOVT
#   2) custom attributes: custom:role, custom:orgId
#   3) App client with USER_PASSWORD_AUTH flow enabled
# Without these, auth runs in mock mode (dev only; refused in production).
AWS_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
EVIDENCE_BUCKET=

# Feature Flags (set to false for E2E/production)
FEATURE_DEMO_ROLE_HEADERS=true
FEATURE_MOCK_ADAPTERS=true

# API Hardening
CORS_ORIGIN=*
JSON_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Stricter brute-force budget for /api/v1/auth/* (requests per window)
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10

# Invitation emails (AWS SESv2). When INVITE_FROM_EMAIL is unset, invites
# return the token for manual copying instead of sending email.
# INVITE_FROM_EMAIL must be a verified SES identity for real delivery.
INVITE_FROM_EMAIL=
INVITE_APP_URL=http://localhost:5173

# AI / ML integration
# ML_SERVICE_URL: anomaly scoring endpoint (no trailing slash, no /api/v1 —
# the backend appends /api/v1/predict). Empty = ML scoring disabled.
ML_SERVICE_URL=http://localhost:8001
# ML_TIMEOUT_MS: abort budget per predict call (fail-open to null on timeout).
ML_TIMEOUT_MS=5000
# AGENT_URL: AI agent orchestrator base (no trailing slash). When set, the
# verification AI route delegates to the agent (backend verification + ML +
# Bedrock) with the caller's auth forwarded; otherwise the local path runs.
AGENT_URL=http://localhost:8002
# Shared Bedrock model for backend adapters and the AI agent.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Real Bedrock analysis uses the standard AWS credential chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or AWS_PROFILE / IAM role)
# in AWS_REGION. Without credentials the adapters fall back to mocks.
