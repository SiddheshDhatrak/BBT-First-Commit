# RahatSetu Backend Configuration
# Copy to .env and fill in values. Never commit real secrets.

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Repository driver: 'memory' (dev/test only) or 'postgres'
REPOSITORY_DRIVER=memory

# Database (PostgreSQL for production)
DATABASE_URL=postgres://rahatsetu:rahatsetu@localhost:5433/rahatsetu
DATABASE_SSL=false

# AWS Configuration
AWS_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
EVIDENCE_BUCKET=

# Feature Flags (set to false for production)
FEATURE_DEMO_ROLE_HEADERS=true
FEATURE_MOCK_ADAPTERS=true

# API Hardening
CORS_ORIGIN=*
JSON_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100