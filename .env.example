# RahatSetu — environment pointer (no secrets in this file)
#
# Frontend → copy frontend/.env.example to frontend/.env
#   VITE_API_URL=https://<ALB_DNS>/api/v1   (local: http://localhost:3000/api/v1)
#   VITE_AGENT_URL=...                      (optional; Copilot stays offline without it)
#   (No Cognito variables: the browser authenticates through the backend /auth/* API.)
#
# Backend → copy backend/.env.example to backend/.env
#   NODE_ENV=development (production in AWS)
#   REPOSITORY_DRIVER=memory               (postgres for E2E/prod)
#   DATABASE_URL=...                       (required when REPOSITORY_DRIVER=postgres)
#   DATABASE_SSL=true                      (managed Postgres)
#   AWS_REGION=ap-south-1
#   COGNITO_USER_POOL_ID=...               (required: backend owns all Cognito calls;
#   COGNITO_CLIENT_ID=...                   app client needs USER_PASSWORD_AUTH enabled)
#   EVIDENCE_BUCKET=...
#   FEATURE_DEMO_ROLE_HEADERS=false        (E2E/prod; mock auth only when Cognito unset in dev)
#   FEATURE_MOCK_ADAPTERS=false            (E2E/prod)
#   CORS_ORIGIN=https://<amplify-domain>   (local: http://localhost:5173)
#   RATE_LIMIT_AUTH_MAX=10                 (auth brute-force budget per minute)
#
# Quick local run (mock auth, memory DB):
#   npm run dev:backend & npm run dev:frontend
#
# Full stack with AI/ML (or: docker compose up --build):
#   ml-service :8001 — train first: cd ml-service && python -m src.train
#   ai-agent   :8002 — AI_PROVIDER=mock (offline) or bedrock (needs AWS creds)
#                        ML_PROVIDER=http (live scoring) or mock (stub)
#   See ai-agent/.env.example for all agent variables.
