# RahatSetu Frontend — copy to .env for local integration. Never commit real secrets.
# When unset, the UI stays on mock-first data in src/lib/mock.ts (Amplify-safe default).

# Backend base URL (no trailing slash). Local: http://localhost:3000/api/v1
# Production: https://<ALB_DNS>/api/v1
VITE_API_URL=

# Quick local integration:
#   1) cd backend && npm ci && npm start        # API on http://localhost:3000
#   2) npm run dev                               # UI on http://localhost:5173 (proxies /api → :3000)
