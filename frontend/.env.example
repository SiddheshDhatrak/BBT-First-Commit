# RahatSetu Frontend — copy to .env for local integration. Never commit real secrets.
# LIVE-ONLY: the UI requires VITE_API_URL (+ Cognito for sign-in). No mock fallback.

# Backend base URL (no trailing slash). Local: http://localhost:3000/api/v1
# Production: https://<ALB_DNS>/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# AI agent base URL (no trailing slash). Local: http://localhost:8002/api/v1
VITE_AGENT_URL=http://localhost:8002/api/v1

# AWS Cognito (required for Login/Register — no demo logins).
# Create a User Pool with groups: DONOR, NGO, VENDOR, FIELD, GOVT,
# custom attributes: custom:orgId, custom:requested_group.
# Admin role = GOVT group + email listed in VITE_ADMIN_EMAILS.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_AWS_REGION=ap-south-1
VITE_ADMIN_EMAILS=

# Quick local integration:
#   1) cd backend && npm ci && npm start        # API on http://localhost:3000
#   2) npm run dev                               # UI on http://localhost:5173 (proxies /api → :3000)
#   3) ml-service on :8001, ai-agent on :8002 (see docker-compose.override.yml)
