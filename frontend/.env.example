# RahatSetu Frontend — copy to .env for local integration. Never commit real secrets.
# When unset, the UI stays on mock-first data in src/lib/mock.ts (Amplify-safe default).

# Backend base URL (no trailing slash). Local: http://localhost:3000/api/v1
# Production: https://<ALB_DNS>/api/v1
VITE_API_URL=

# AI agent base URL (no trailing slash). Local: http://localhost:8002/api/v1
# When unset, Copilot stays backend-routed (direct agent dot disabled).
VITE_AGENT_URL=

# ML service base URL (optional, health dot only — scoring is backend-proxied).
# Local: http://localhost:8001/api/v1 — unset = ML proxied via backend, no direct calls.
VITE_ML_URL=

# Admin allowlist (comma-separated emails). GOVT-group users whose email is
# listed here open the admin console (approval queue + rules); all other
# GOVT users open the auditor console. Required to reach /admin/*.
VITE_ADMIN_EMAILS=

# Quick local integration:
#   1) cd backend && npm ci && npm start        # API on http://localhost:3000
#   2) npm run dev                               # UI on http://localhost:5173 (proxies /api → :3000)
